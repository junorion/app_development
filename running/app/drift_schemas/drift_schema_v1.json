  "fixed_sql": [
    {
      "name": "runs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"runs\" (\"id\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"tz_offset_min\" INTEGER NOT NULL, \"ended_at\" INTEGER NULL, \"moving_time_sec\" REAL NOT NULL DEFAULT 0.0, \"distance_m\" REAL NOT NULL DEFAULT 0.0, \"avg_speed_mps\" REAL NOT NULL DEFAULT 0.0, \"avg_cadence_spm\" REAL NULL, \"total_steps\" REAL NULL, \"status\" TEXT NOT NULL, \"timer_preset_id\" TEXT NULL, \"snapshot_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "track_points",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"track_points\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"run_id\" TEXT NOT NULL REFERENCES runs (id) ON DELETE CASCADE, \"ts\" INTEGER NOT NULL, \"lat\" REAL NOT NULL, \"lng\" REAL NOT NULL, \"accuracy_m\" REAL NOT NULL, \"speed_mps\" REAL NULL, \"altitude_m\" REAL NULL, \"segment_index\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "splits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"splits\" (\"run_id\" TEXT NOT NULL REFERENCES runs (id) ON DELETE CASCADE, \"index\" INTEGER NOT NULL, \"distance_m\" REAL NOT NULL, \"duration_sec\" REAL NOT NULL, \"avg_cadence_spm\" REAL NULL, \"is_partial\" INTEGER NOT NULL CHECK (\"is_partial\" IN (0, 1)), PRIMARY KEY (\"run_id\", \"index\"));"
        }
      ]
    },
    {
      "name": "timer_presets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"timer_presets\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"repeat_count\" INTEGER NOT NULL DEFAULT 1, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "timer_blocks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"timer_blocks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"preset_id\" TEXT NOT NULL REFERENCES timer_presets (id) ON DELETE CASCADE, \"order\" INTEGER NOT NULL, \"repeat_count\" INTEGER NOT NULL DEFAULT 1);"
        }
      ]
    },
    {
      "name": "timer_steps",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"timer_steps\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"block_id\" INTEGER NOT NULL REFERENCES timer_blocks (id) ON DELETE CASCADE, \"order\" INTEGER NOT NULL, \"label\" TEXT NOT NULL, \"duration_sec\" INTEGER NOT NULL, \"type\" TEXT NOT NULL, \"sound_id\" TEXT NULL, \"vibrate\" INTEGER NOT NULL DEFAULT 1 CHECK (\"vibrate\" IN (0, 1)), \"voice_text\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "track_run_ts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX track_run_ts ON track_points (run_id, ts)"
        }
      ]
    }
  ]
